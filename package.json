    "db:migrate": "node scripts/migrate.cjs",
    "test:e2e:plan": "node tests/e2e/plan.cjs",
    "test:e2e:engagement": "node tests/e2e/engagement.cjs",
    "test:e2e:legal": "node tests/e2e/legal.cjs",
