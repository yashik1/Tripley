# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app (safe to be public).

# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Sign-in methods to show (comma-separated): password (email + password accounts,
# with forgot/reset password), phone, email (6-digit email code), google, apple, guest.
# Only list methods whose provider is set up in Supabase. Empty = all.
# Password resets and email codes need SMTP set up on the auth server.
EXPO_PUBLIC_AUTH_METHODS=password,guest

# Domain you own; invite links look like https://<domain>/join/<code>
EXPO_PUBLIC_APP_DOMAIN=tripley.app

# Public contact address shown on the Privacy Policy and Terms pages (/privacy,
# /terms) and in the profile. Leave empty and the pages say one is coming.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Map style. Defaults to OpenFreeMap (free, no key). For MapTiler use:
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
EXPO_PUBLIC_MAP_STYLE_URL=

# RevenueCat public SDK keys (Project -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Native build identifiers
TRIPLEY_BUNDLE_ID=app.tripley
EAS_PROJECT_ID=
