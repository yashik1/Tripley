# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app (safe to be public).

# Supabase project (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Domain you own; invite links look like https://<domain>/join/<code>
EXPO_PUBLIC_APP_DOMAIN=tripley.app

# Map style. Defaults to OpenFreeMap (free, no key). For MapTiler use:
# https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
EXPO_PUBLIC_MAP_STYLE_URL=

# RevenueCat public SDK keys (Project -> API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_WEB_KEY=

# Native build identifiers
TRIPLEY_BUNDLE_ID=app.tripley
EAS_PROJECT_ID=
